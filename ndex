<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>🎂 Chúc Mừng Sinh Nhật Hồng Thắm 🎂</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --pink:#ff8fab;
    --pink-dark:#ff4d81;
    --cream:#fff0f3;
    --purple:#b185db;
    --gold:#ffd166;
    --ink:#6b3b52;
    color-scheme: light;
  }
  *{box-sizing:border-box}
  html,body{
    height:100%;
    margin:0;
    padding:0;
    overflow:hidden;
    background:#ffe3ec;
  }
  body{
    font-family:'Quicksand','Segoe UI',sans-serif;
    color:var(--ink);
    -webkit-tap-highlight-color:transparent;
  }
  .screen{
    position:fixed;
    inset:0;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
    background:linear-gradient(160deg,#ffe3ec 0%,#fff0f3 45%,#ece0ff 100%);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
  }
  h1,h2,.btn{font-family:'Baloo 2','Baloo 2',cursive,sans-serif}

  /* ---------- Màn hình mở đầu ---------- */
  #intro{z-index:40;text-align:center;padding:24px;overflow:hidden}
  #intro .glow{
    position:absolute;
    top:50%;left:50%;
    width:340px;height:340px;
    background:radial-gradient(circle,rgba(255,180,205,.55) 0%,rgba(255,180,205,0) 70%);
    transform:translate(-50%,-50%);
    animation:glowPulse 3.2s ease-in-out infinite;
    pointer-events:none;
  }
  @keyframes glowPulse{0%,100%{opacity:.55;transform:translate(-50%,-50%) scale(1)}50%{opacity:.9;transform:translate(-50%,-50%) scale(1.15)}}
  .intro-sparkles{position:absolute;inset:0;pointer-events:none}
  .intro-sparkles span{
    position:absolute;
    bottom:-40px;
    font-size:1.1rem;
    opacity:0;
    animation:floatUp 6s linear infinite;
  }
  .intro-sparkles span:nth-child(1){left:8%;font-size:1.3rem;animation-delay:0s;animation-duration:6.5s}
  .intro-sparkles span:nth-child(2){left:20%;font-size:.9rem;animation-delay:1.1s;animation-duration:5.4s}
  .intro-sparkles span:nth-child(3){left:34%;font-size:1.15rem;animation-delay:2.2s;animation-duration:7s}
  .intro-sparkles span:nth-child(4){left:50%;font-size:.85rem;animation-delay:.5s;animation-duration:6s}
  .intro-sparkles span:nth-child(5){left:64%;font-size:1.25rem;animation-delay:1.7s;animation-duration:6.8s}
  .intro-sparkles span:nth-child(6){left:78%;font-size:.95rem;animation-delay:2.8s;animation-duration:5.8s}
  .intro-sparkles span:nth-child(7){left:90%;font-size:1.1rem;animation-delay:.9s;animation-duration:7.2s}
  .intro-sparkles span:nth-child(8){left:45%;font-size:1rem;animation-delay:3.4s;animation-duration:6.3s}
  @keyframes floatUp{
    0%{transform:translateY(0) rotate(0deg);opacity:0}
    10%{opacity:.9}
    85%{opacity:.7}
    100%{transform:translateY(-115vh) rotate(360deg);opacity:0}
  }
  #intro h1{
    margin:0 0 6px;
    font-size:clamp(1.9rem,7vw,3.2rem);
    font-weight:800;
    line-height:1.15;
    color:var(--pink-dark);
    text-shadow:3px 3px 0 #fff,0 0 18px rgba(255,120,170,.4);
    position:relative;
    animation:titleGlow 2.6s ease-in-out infinite;
  }
  @keyframes titleGlow{
    0%,100%{text-shadow:3px 3px 0 #fff,0 0 14px rgba(255,120,170,.35)}
    50%{text-shadow:3px 3px 0 #fff,0 0 26px rgba(255,120,170,.65)}
  }
  #intro p{margin:0 0 26px;font-size:clamp(.95rem,3.6vw,1.15rem);color:#a86b8e;font-weight:600;position:relative;animation:fadeInUp .8s ease .2s both}
  @keyframes fadeInUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .plushies{display:flex;gap:10px;font-size:clamp(2.2rem,10vw,3.4rem);margin-bottom:18px;position:relative}
  .plushies span{display:inline-block;animation:bounce 1.4s ease-in-out infinite}
  .plushies span:nth-child(2){animation-delay:.15s}
  .plushies span:nth-child(3){animation-delay:.3s}
  .plushies span:nth-child(4){animation-delay:.45s}
  .plushies span:nth-child(5){animation-delay:.6s}
  @keyframes bounce{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-16px) rotate(4deg)}}
  #startBtn{animation:btnPulse 1.8s ease-in-out infinite}
  @keyframes btnPulse{0%,100%{box-shadow:0 8px 0 #e0386c,0 14px 24px rgba(255,77,129,.35)}50%{box-shadow:0 8px 0 #e0386c,0 14px 34px rgba(255,77,129,.6)}}
  .btn{
    border:none;
    cursor:pointer;
    font-size:clamp(1.05rem,4.4vw,1.35rem);
    font-weight:700;
    color:#fff;
    padding:14px 34px;
    border-radius:999px;
    background:linear-gradient(135deg,#ff7aa2,#ff4d81);
    box-shadow:0 8px 0 #e0386c,0 14px 24px rgba(255,77,129,.35);
    transition:transform .12s ease,box-shadow .12s ease;
  }
  .btn:active{transform:translateY(5px);box-shadow:0 3px 0 #e0386c,0 6px 14px rgba(255,77,129,.3)}
  .btn:focus-visible{outline:3px solid var(--purple);outline-offset:3px}

  /* ---------- Màn chơi ---------- */
  #game{z-index:10;justify-content:flex-start;opacity:0;pointer-events:none;transition:opacity .5s ease}
  #game.on{opacity:1;pointer-events:auto}
  #hud{
    width:100%;
    padding:14px 16px 0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    pointer-events:none;
  }
  #score{
    background:rgba(255,255,255,.75);
    border:2px solid #ffc2d4;
    border-radius:999px;
    padding:7px 16px;
    font-weight:700;
    font-size:1rem;
    color:var(--pink-dark);
    backdrop-filter:blur(4px);
  }
  #mute{
    pointer-events:auto;
    border:2px solid #ffc2d4;
    background:rgba(255,255,255,.75);
    border-radius:999px;
    width:42px;height:42px;
    font-size:1.1rem;
    cursor:pointer;
  }
  #hint{
    margin-top:10px;
    font-size:.92rem;
    font-weight:600;
    color:#a86b8e;
    opacity:.9;
    text-align:center;
    padding:0 20px;
    pointer-events:none;
  }
  #arena{position:absolute;inset:0;overflow:hidden}
  .heart,.bullet,.pop{position:absolute;will-change:transform;user-select:none}
  .heart{
    line-height:1;
    width:52px;height:52px;
    border-radius:50%;
    border:3px solid #ff6f96;
    box-shadow:0 3px 8px rgba(255,90,140,.4),0 0 0 4px rgba(255,255,255,.55);
    overflow:hidden;
    background:#fff;
  }
  .heart img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
  .heart .mini-heart{
    position:absolute;
    right:-4px;bottom:-4px;
    font-size:16px;
    filter:drop-shadow(0 1px 2px rgba(0,0,0,.25));
  }
  .bullet{font-size:22px;line-height:1}
  .pop{font-size:26px;font-weight:700;color:var(--pink-dark);font-family:'Baloo 2',cursive;animation:pop .7s ease-out forwards;pointer-events:none}
  @keyframes pop{0%{transform:scale(.6);opacity:1}100%{transform:scale(1.5) translateY(-40px);opacity:0}}
  #cannon{
    position:absolute;
    bottom:calc(14px + env(safe-area-inset-bottom,0px));
    left:50%;
    transform:translateX(-50%);
    font-size:46px;
    line-height:1;
    pointer-events:none;
    transition:transform .08s ease;
  }

  /* ---------- Món quà ---------- */
  #gift{z-index:30;display:none;overflow-y:auto;justify-content:flex-start}
  #gift.on{display:flex}
  .card{
    max-width:420px;
    width:calc(100% - 32px);
    margin:auto;
    padding:22px 22px 26px;
    background:rgba(255,255,255,.92);
    border:3px solid #ffd0de;
    border-radius:28px;
    box-shadow:0 18px 40px rgba(200,110,150,.25);
    text-align:center;
    animation:rise .6s cubic-bezier(.2,.9,.3,1.2);
  }
  @keyframes rise{from{transform:translateY(28px) scale(.94);opacity:0}to{transform:none;opacity:1}}
  .card h2{
    margin:0 0 4px;
    font-size:clamp(1.5rem,6vw,2rem);
    font-weight:800;
    color:var(--pink-dark);
    text-shadow:2px 2px 0 #fff;
  }
  .photo-frame{
    margin:14px auto 16px;
    width:200px;
    padding:9px 9px 34px;
    background:#fff;
    border-radius:8px;
    box-shadow:0 10px 24px rgba(180,100,140,.28);
    transform:rotate(-2.5deg);
    position:relative;
  }
  .photo-frame img{width:100%;display:block;border-radius:4px}
  .photo-frame figcaption{
    position:absolute;
    left:0;right:0;bottom:9px;
    font-family:'Baloo 2',cursive;
    font-size:1rem;
    color:var(--pink-dark);
  }
  .tape{
    position:absolute;
    top:-12px;left:50%;
    transform:translateX(-50%) rotate(3deg);
    width:78px;height:24px;
    background:rgba(255,209,102,.6);
    border-radius:3px;
  }
  .wish{font-size:1rem;line-height:1.75;margin:0 0 14px;font-weight:600;text-align:left}
  .wish #wishEm{color:var(--pink-dark);font-weight:700}
  .typer-cursor{
    display:inline-block;
    width:2px;
    background:var(--pink-dark);
    margin-left:2px;
    animation:blink 1s step-end infinite;
  }
  @keyframes blink{50%{opacity:0}}
  .sign,#againBtn{
    opacity:0;
    transition:opacity .5s ease;
  }
  .sign.show,#againBtn.show{opacity:1}
  .sign{
    font-family:'Baloo 2',cursive;
    font-size:1.05rem;
    color:var(--purple);
    margin:0 0 18px;
    font-weight:700;
  }
  .confetti{position:fixed;top:-20px;font-size:18px;pointer-events:none;z-index:31;animation:fall linear forwards}
  @keyframes fall{to{transform:translateY(105vh) rotate(720deg);opacity:.2}}

  .burst-heart{
    position:fixed;
    pointer-events:none;
    z-index:32;
    font-size:22px;
    animation:burstFly ease-out forwards;
  }
  @keyframes burstFly{
    0%{transform:translate(0,0) scale(.3) rotate(0deg);opacity:1}
    70%{opacity:1}
    100%{transform:translate(var(--bx),var(--by)) scale(1.15) rotate(var(--br));opacity:0}
  }
  .sparkle{
    position:fixed;
    pointer-events:none;
    z-index:32;
    font-size:16px;
    animation:sparkleTwinkle ease-in-out forwards;
  }
  @keyframes sparkleTwinkle{
    0%{transform:translate(0,0) scale(0);opacity:0}
    30%{transform:translate(calc(var(--bx)*.4),calc(var(--by)*.4)) scale(1.3);opacity:1}
    100%{transform:translate(var(--bx),var(--by)) scale(.2);opacity:0}
  }
  .flash{
    position:fixed;
    inset:0;
    z-index:29;
    background:radial-gradient(circle,rgba(255,255,255,.95) 0%,rgba(255,214,232,.4) 45%,rgba(255,214,232,0) 75%);
    pointer-events:none;
    animation:flashOut .8s ease-out forwards;
  }
  @keyframes flashOut{0%{opacity:1}100%{opacity:0}}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  }
</style>
</head>
<body>

<!-- Màn hình mở đầu -->
<section id="intro" class="screen">
  <div class="glow" aria-hidden="true"></div>
  <div class="intro-sparkles" aria-hidden="true">
    <span>✨</span><span>🎈</span><span>💗</span><span>✨</span>
    <span>🌸</span><span>💫</span><span>🎉</span><span>✨</span>
  </div>
  <div class="plushies"><span>🧸</span><span>🐰</span><span>🐻</span><span>🐼</span><span>🐱</span></div>
  <h1>Chúc mừng sinh nhật<br>Hồng Thắm 🎂</h1>
  <p>Bắn trúng 10 trái tim để mở quà nha 💌</p>
  <button class="btn" id="startBtn">Bắt đầu 🎁</button>
</section>

<!-- Màn chơi -->
<section id="game" class="screen">
  <div id="hud">
    <div id="score">💗 0 / 10</div>
    <button id="mute" title="Bật/tắt nhạc" aria-label="Bật hoặc tắt nhạc">🔊</button>
  </div>
  <p id="hint">Chạm vào màn hình để bắn tim 💘</p>
  <div id="arena"></div>
  <div id="cannon">🎯</div>
</section>

<!-- Quà -->
<section id="gift" class="screen">
  <div class="card">
    <h2>Happy Birthday Hồng Thắm! 🎉</h2>
    <figure class="photo-frame">
      <div class="tape"></div>
      <img src="data:image/jpeg;base64," alt="Ảnh của Hồng Thắm">
      <figcaption>Hồng Thắm 💕</figcaption>
    </figure>
    <p class="wish">
      <span id="wishMain"></span><span id="wishEm"></span><span class="typer-cursor" id="typerCursor">&nbsp;</span>
    </p>
    <p class="sign" id="signEl">người gửi<br>NGUYỄN QUỐC PHONG ĐẸP TRAI 😎</p>
    <button class="btn" id="againBtn">Chơi lại 🎈</button>
  </div>
</section>

<audio id="bgm" loop preload="auto" src="data:audio/mpeg;base64,"></audio>

<script>
(function(){
  const intro   = document.getElementById('intro');
  const game    = document.getElementById('game');
  const gift    = document.getElementById('gift');
  const arena   = document.getElementById('arena');
  const cannon  = document.getElementById('cannon');
  const scoreEl = document.getElementById('score');
  const bgm     = document.getElementById('bgm');
  const muteBtn = document.getElementById('mute');

  const TARGET = 10;
  const PHOTOS = ['data:image/jpeg;base64,','data:image/jpeg;base64,'];
  let hearts = [], bullets = [], score = 0, running = false, raf = null, spawnTimer = 0;

  /* ---- nhạc ---- */
  bgm.volume = 0.65;
  function playMusic(){
    const p = bgm.play();
    if(p && p.catch) p.catch(()=>{ muteBtn.textContent = '🔈'; });
  }
  muteBtn.addEventListener('click', e => {
    e.stopPropagation();
    if(bgm.paused){ playMusic(); muteBtn.textContent = '🔊'; }
    else { bgm.pause(); muteBtn.textContent = '🔇'; }
  });

  /* ---- vòng đời game ---- */
  function reset(){
    arena.innerHTML = '';
    hearts = []; bullets = []; score = 0; spawnTimer = 0;
    scoreEl.textContent = '💗 0 / ' + TARGET;
  }

  function start(){
    reset();
    intro.style.display = 'none';
    gift.classList.remove('on');
    game.classList.add('on');
    running = true;
    playMusic();
    last = performance.now();
    raf = requestAnimationFrame(loop);
  }

  function spawnHeart(){
    const el = document.createElement('div');
    el.className = 'heart';
    el.style.position = 'absolute';
    const img = document.createElement('img');
    img.src = PHOTOS[(Math.random()*PHOTOS.length)|0];
    img.alt = 'Hồng Thắm';
    el.appendChild(img);
    const mini = document.createElement('span');
    mini.className = 'mini-heart';
    mini.textContent = '💗';
    el.appendChild(mini);
    arena.appendChild(el);
    const size = 52;
    const h = {
      el,
      x: Math.random() * (window.innerWidth - size - 20) + 10,
      y: -60,
      vx: (Math.random() - .5) * 60,
      vy: 40 + Math.random() * 45,
      r: size * .5
    };
    hearts.push(h);
  }

  function shoot(cx, cy){
    if(!running) return;
    const rect  = cannon.getBoundingClientRect();
    const sx    = rect.left + rect.width / 2;
    const sy    = rect.top;
    const dx    = cx - sx, dy = cy - sy;
    const d     = Math.hypot(dx, dy) || 1;
    const speed = 700;
    const el = document.createElement('div');
    el.className = 'bullet';
    el.textContent = '💘';
    arena.appendChild(el);
    bullets.push({ el, x: sx - 11, y: sy - 11, vx: dx/d*speed, vy: dy/d*speed, r: 12 });
    const ang = Math.max(-35, Math.min(35, dx / window.innerWidth * 80));
    cannon.style.transform = 'translateX(-50%) rotate(' + ang + 'deg)';
  }

  function burst(x, y){
    const el = document.createElement('div');
    el.className = 'pop';
    el.textContent = '+1';
    el.style.left = x + 'px';
    el.style.top  = y + 'px';
    arena.appendChild(el);
    setTimeout(()=> el.remove(), 700);
  }

  let last = 0;
  function loop(now){
    const dt = Math.min((now - last) / 1000, .05);
    last = now;

    spawnTimer -= dt;
    if(spawnTimer <= 0 && hearts.length < 7){
      spawnHeart();
      spawnTimer = .55 + Math.random() * .5;
    }

    for(let i = hearts.length - 1; i >= 0; i--){
      const h = hearts[i];
      h.x += h.vx * dt; h.y += h.vy * dt;
      if(h.x < 4 || h.x > window.innerWidth - 44) h.vx *= -1;
      if(h.y > window.innerHeight + 60){ h.el.remove(); hearts.splice(i,1); continue; }
      h.el.style.transform = 'translate(' + h.x + 'px,' + h.y + 'px)';
    }

    for(let i = bullets.length - 1; i >= 0; i--){
      const b = bullets[i];
      b.x += b.vx * dt; b.y += b.vy * dt;
      if(b.y < -40 || b.x < -40 || b.x > window.innerWidth + 40){ b.el.remove(); bullets.splice(i,1); continue; }
      b.el.style.transform = 'translate(' + b.x + 'px,' + b.y + 'px)';

      for(let j = hearts.length - 1; j >= 0; j--){
        const h = hearts[j];
        if(Math.hypot((b.x + 11) - (h.x + h.r), (b.y + 11) - (h.y + h.r)) < h.r + b.r){
          burst(h.x, h.y);
          h.el.remove(); hearts.splice(j,1);
          b.el.remove(); bullets.splice(i,1);
          score++;
          scoreEl.textContent = '💗 ' + score + ' / ' + TARGET;
          if(score >= TARGET){ win(); return; }
          break;
        }
      }
    }
    raf = requestAnimationFrame(loop);
  }

  function win(){
    running = false;
    cancelAnimationFrame(raf);
    game.classList.remove('on');
    gift.classList.add('on');
    confetti();
    startTypewriter();
  }

  /* ---- hiệu ứng gõ chữ chạy dần ---- */
  const WISH_MAIN = 'Phong chúc Hồng Thắm có buổi sinh nhật thật nhiều niềm vui và vui vẻ bên gia đình, luôn luôn xinh đẹp, gặp nhiều may mắn hơn, học giỏi hơn, có nhiều sức khỏe hơn và đạt được nhiều nguyện vọng và mục tiêu trong tương lai, mọi ước mơ đều thành hiện thực. ';
  const WISH_EM   = 'Cảm ơn vì đã luôn là chính Hồng Thắm! 🎈🎂✨';
  let typeTimer = null;

  function startTypewriter(){
    const mainEl = document.getElementById('wishMain');
    const emEl   = document.getElementById('wishEm');
    const cursor = document.getElementById('typerCursor');
    const signEl = document.getElementById('signEl');
    const again  = document.getElementById('againBtn');

    mainEl.textContent = '';
    emEl.textContent = '';
    signEl.classList.remove('show');
    again.classList.remove('show');
    cursor.style.display = 'inline-block';
    if(typeTimer) clearInterval(typeTimer);

    const full = WISH_MAIN + WISH_EM;
    let i = 0;
    const speed = 32; // ms mỗi ký tự

    typeTimer = setInterval(()=>{
      i++;
      if(i <= WISH_MAIN.length){
        mainEl.textContent = WISH_MAIN.slice(0, i);
      } else {
        emEl.textContent = WISH_EM.slice(0, i - WISH_MAIN.length);
      }
      if(i >= full.length){
        clearInterval(typeTimer);
        cursor.style.display = 'none';
        signEl.classList.add('show');
        again.classList.add('show');
      }
    }, speed);
  }

  function confetti(){
    // ánh sáng bùng lên một nhịp khi vừa thắng
    const flash = document.createElement('div');
    flash.className = 'flash';
    document.body.appendChild(flash);
    setTimeout(()=> flash.remove(), 900);

    // mưa confetti nhiều lớp, thả liên tục vài đợt
    const bits = ['🎉','🎊','💗','🎈','✨','🌸','🧸','💖','🌟'];
    function rainWave(count){
      for(let i = 0; i < count; i++){
        const c = document.createElement('div');
        c.className = 'confetti';
        c.textContent = bits[(Math.random()*bits.length)|0];
        c.style.left = Math.random() * 100 + 'vw';
        c.style.fontSize = (16 + Math.random()*14) + 'px';
        c.style.animationDuration = (2.6 + Math.random()*2.4) + 's';
        c.style.animationDelay = (Math.random()*.8) + 's';
        document.body.appendChild(c);
        setTimeout(()=> c.remove(), 7000);
      }
    }
    rainWave(40);
    setTimeout(()=> rainWave(26), 500);
    setTimeout(()=> rainWave(20), 1100);

    // chùm tim bắn toả tròn từ giữa màn hình, như pháo hoa
    const heartFaces = ['💗','💖','💕','❤️','💓','🩷','💘'];
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight * .38;
    function heartBurst(originX, originY, n){
      for(let i = 0; i < n; i++){
        const h = document.createElement('div');
        h.className = 'burst-heart';
        h.textContent = heartFaces[(Math.random()*heartFaces.length)|0];
        const angle = (Math.PI * 2 * i) / n + Math.random()*.3;
        const dist  = 90 + Math.random()*160;
        h.style.left = originX + 'px';
        h.style.top  = originY + 'px';
        h.style.setProperty('--bx', (Math.cos(angle)*dist) + 'px');
        h.style.setProperty('--by', (Math.sin(angle)*dist - 40) + 'px');
        h.style.setProperty('--br', (Math.random()*140 - 70) + 'deg');
        h.style.animationDuration = (1.1 + Math.random()*.6) + 's';
        document.body.appendChild(h);
        setTimeout(()=> h.remove(), 2000);
      }
    }
    heartBurst(cx, cy, 22);
    setTimeout(()=> heartBurst(cx*.5, cy*1.3, 14), 350);
    setTimeout(()=> heartBurst(cx*1.5, cy*1.3, 14), 600);

    // lấp lánh rải rác khắp màn hình
    function sparkleField(n){
      for(let i = 0; i < n; i++){
        const s = document.createElement('div');
        s.className = 'sparkle';
        s.textContent = '✨';
        const x = Math.random() * window.innerWidth;
        const y = Math.random() * window.innerHeight * .8 + 20;
        s.style.left = x + 'px';
        s.style.top  = y + 'px';
        s.style.setProperty('--bx', (Math.random()*40 - 20) + 'px');
        s.style.setProperty('--by', (Math.random()*40 - 20) + 'px');
        s.style.animationDuration = (1 + Math.random()*.8) + 's';
        s.style.animationDelay = (Math.random()*.6) + 's';
        document.body.appendChild(s);
        setTimeout(()=> s.remove(), 2200);
      }
    }
    sparkleField(30);
    setTimeout(()=> sparkleField(22), 700);
  }

  /* ---- điều khiển ---- */
  document.getElementById('startBtn').addEventListener('click', start);
  document.getElementById('againBtn').addEventListener('click', ()=>{
    gift.classList.remove('on');
    start();
  });
  game.addEventListener('pointerdown', e => {
    if(e.target.id === 'mute') return;
    shoot(e.clientX, e.clientY);
  });
  window.addEventListener('keydown', e => {
    if(e.code === 'Space' && running){
      e.preventDefault();
      shoot(window.innerWidth/2, 80);
    }
  });
})();
</script>
</body>
</html>
